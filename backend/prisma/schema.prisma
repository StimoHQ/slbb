generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============
enum StudyStatus {
  LEARNING // В процессе изучения
  REVIEWING // На этапе повторения
  MASTERED // Выучено
}

enum LearningLanguage {
  ENG
}

enum NativeLanguage {
  RU
}

enum Source {
  GUTENBERG
}

model User {
  // Fields
  id               Int               @id @default(autoincrement())
  email            String            @unique
  name             String?
  nativeLanguage   NativeLanguage    @default(RU) @map("native_language")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  userLexicalUnits UserLexicalUnit[]

  //Table Meta
  @@map("users")
}

model Text {
  // Fields
  id          Int                     @id @default(autoincrement())
  title       String
  language    LearningLanguage        @default(ENG)
  content     TextContent?
  source      Source                  @default(GUTENBERG)
  sourceObjId Int                     @map("source_obj_id")
  sourceMeta  Json?                   @map("source_meta") @db.JsonB
  occurrences LexicalUnitOccurrence[]
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  //Table Meta
  @@unique([source, sourceObjId])
  @@map("texts")
}

model LexicalUnit {
  // Fields
  id               Int                     @id @default(autoincrement())
  value            String
  occurrences      LexicalUnitOccurrence[]
  userLexicalUnits UserLexicalUnit[]
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  //Table Meta
  @@unique([value])
  @@map("lexical_units")
}

model TextContent {
  // Fields
  id        Int      @id @default(autoincrement())
  textId    Int      @unique @map("text_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Relations
  text      Text     @relation(fields: [textId], references: [id], onDelete: Cascade)

  //Table Meta
  @@map("text_contents")
}

model LexicalUnitOccurrence {
  // Fields
  id                     Int         @id @default(autoincrement())
  textId                 Int         @map("text_id")
  lexicalUnitId          Int         @map("lexical_unit_id")
  lexicalUnitStartPos    Int         @map("lexical_unit_start_pos")
  lexicalUnitTranslation String      @map("lexical_unit_translation")
  context                String      @db.Text
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  // Relations
  text                   Text        @relation(fields: [textId], references: [id], onDelete: Cascade)
  lexicalUnit            LexicalUnit @relation(fields: [lexicalUnitId], references: [id], onDelete: Cascade)

  //Table Meta
  @@map("lexical_unit_occurrences")
}

model UserLexicalUnit {
  // Fields
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  lexicalUnitId Int         @map("lexical_unit_id")
  status        StudyStatus @default(LEARNING)
  userNote      String?     @map("user_note")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  // Relations
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexicalUnit   LexicalUnit @relation(fields: [lexicalUnitId], references: [id], onDelete: NoAction)

  //Table Meta
  @@unique([userId, lexicalUnitId])
  @@map("user_lexical_units")
}
