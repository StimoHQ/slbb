generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============
enum StudyStatus {
  LEARNING // В процессе изучения
  REVIEWING // На этапе повторения
  MASTERED // Выучено
}

enum Language {
  ENG
  RU
}

enum TextType {
  BOOK
  ARTICLE
  RSS_FEED
}

enum TextFormat {
  TXT
  HTML
  MARKDOWN
  PDF
}

enum Source {
  GUTENBERG
}

model User {
  // Fields
  id        Int         @id @default(autoincrement())
  email     String      @unique
  name      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  userWords UserWords[]

  //Table Meta
  @@map("users")
}

model Word {
  // Fields
  id              Int              @id @default(autoincrement())
  lemma           String
  language        Language         @default(ENG)
  wordOccurrences WordOccurrence[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  //Table Meta
  @@unique([lemma, language])
  @@map("words")
}

model Text {
  // Fields
  id              Int              @id @default(autoincrement())
  title           String
  content         TextContent?
  type            TextType
  format          TextFormat
  source          Source           @default(GUTENBERG)
  sourceObjId     Int              @map("source_obj_id")
  sourceMeta      Json?            @map("source_meta") @db.JsonB
  wordOccurrences WordOccurrence[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  //Table Meta
  @@unique([source, sourceObjId])
  @@map("texts")
}

model TextContent {
  // Fields
  id        Int      @id @default(autoincrement())
  textId    Int      @unique @map("text_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Relations
  text      Text     @relation(fields: [textId], references: [id], onDelete: Cascade)

  //Table Meta
  @@map("text_contents")
}

model WordOccurrence {
  // Fields
  id          Int         @id @default(autoincrement())
  textId      Int         @map("text_id")
  wordId      Int         @map("word_id")
  context     String      @db.Text
  position    Int
  translation String      @db.Text
  userWords   UserWords[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  // Relations
  text        Text        @relation(fields: [textId], references: [id], onDelete: Cascade)
  word        Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)

  //Table Meta
  @@map("word_occurrences")
}

model UserWords {
  // Fields
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  wordOccurrenceId Int            @map("word_occurrence_id")
  status           StudyStatus    @default(LEARNING)
  userNote         String         @map("user_note")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  // Relations
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordOccurrence   WordOccurrence @relation(fields: [wordOccurrenceId], references: [id], onDelete: NoAction)

  //Table Meta
  @@unique([userId, wordOccurrenceId])
  @@map("user_words")
}
