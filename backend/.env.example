# APP
HTTP_PORT=4000
HTTP_HOST=localhost

# PostgreSQL
DATABASE_URL=postgresql://admin:123456@localhost:5432/db_name?schema=public
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432
POSTGRES_DB=db_name

# PGAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=123456
PGADMIN_PORT=8080

# LibreTranslate
LIBRETRANSLATE_PORT=5000
LT_LOAD_ONLY="en,ru"
# Base URL the backend reaches LibreTranslate at (used to detect a language when a book has no "Language:" header)
LIBRETRANSLATE_URL=http://localhost:5000

# Gutenberg Loader
# Where the book files are taken from: "url" (remote) or "local" (files on disk, for development)
GUTENBERG_SOURCE_TYPE=url
# Base of the Gutenberg cache; the final path is {base}/{bookId}/pg{bookId}.txt
GUTENBERG_BASE_URL=https://www.gutenberg.org/cache/epub
# Directory with book files for GUTENBERG_SOURCE_TYPE=local (relative to the process cwd), files named pg{bookId}.txt
GUTENBERG_LOCAL_DIR=test-data
