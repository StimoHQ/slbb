# APP
HTTP_PORT=4000
HTTP_HOST=localhost

# PostgreSQL
# Приложение и Prisma работают на хосте, поэтому хост в URL — localhost:
# это hostPort, который k3s ServiceLB публикует из Service postgres (port: 5432).
# Если приложение переедет в Pod того же кластера, хост меняется на postgres.slbb.svc.cluster.local.
DATABASE_URL=postgresql://admin:123456@localhost:5432/db_name?schema=public
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432
POSTGRES_DB=db_name

# PGAdmin
# Логин в web-интерфейсе: PGADMIN_DEFAULT_EMAIL / PGADMIN_DEFAULT_PASSWORD.
# Сервер PostgreSQL внутри pgAdmin регистрируется автоматически (ConfigMap pgadmin-servers)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=123456
PGADMIN_PORT=8080

# LibreTranslate
LIBRETRANSLATE_PORT=5000
LT_LOAD_ONLY="en,ru"

# Kubernetes
# namespace, в который разворачивается k8s/base; должен совпадать с namespace в манифестах.
K8S_NAMESPACE=slbb

# API key for RapidAPI
X-RapidAPI-Key=YOUR_API_KEY
X-RapidAPI-Host-Gutenberg=HOST_API_GUTENBERG

# Kafka — официальный образ docker.io/apache/kafka, режим KRaft (broker+controller в одном
# процессе, без Zookeeper). Имена не переименовывать: entrypoint образа превращает любой
# KAFKA_FOO_BAR в свойство брокера foo.bar, поэтому в контейнер попадает только разрешённый
# набор (ConfigMap kafka-config, см. k8s/apply-env.sh).
# CLUSTER_ID — идентификатор кластера, генерируется один раз на хранилище:
#   kubectl -n slbb exec kafka-0 -- /opt/kafka/bin/kafka-storage.sh random-uuid
# На живом (уже отформатированном) PVC его смена = crash loop «Inconsistent cluster id».
CLUSTER_ID=YOUR_CLUSTER_ID
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_NODE_ID=1
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
# Каталог данных: в образе по умолчанию log.dirs=/tmp/kraft-combined-logs, т.е. эфемерно.
# PVC kafka mounted at exactly this path (k8s/base/kafka.yaml).
KAFKA_LOG_DIRS=/var/lib/kafka/data
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
# Heap JVM for dev single-node cluster; otherwise the image uses ~1G
KAFKA_HEAP_OPTS=-Xmx512M -Xms256M
# Публикуемый на хосте порт (k3s ServiceLB hostPort). В контейнер НЕ передаётся:
# KAFKA_PORT дал бы свойство port, удалённое из Kafka 4.x. Нужен только проверке портов в apply-env.sh.
KAFKA_PORT=9092
